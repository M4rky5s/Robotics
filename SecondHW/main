#include <LiquidCrystal.h>

// Pinai
int pinLedRed = 11;
int pinLedBlue = 10;
int pinLedGreen = 9;
int pinButton = 8;

LiquidCrystal lcd(7, 6, 5, 4, 3, 2);

int lastButtonState = HIGH;

// Padariau taip, nes čia ir buvo problema su ledu, kadangi spalvos buvo visai ne tokios, kaip buvau nustated RGB
void setColor(int red, int green, int blue){
  analogWrite(pinLedRed,   255 - constrain(red,   0, 255));
  analogWrite(pinLedGreen, 255 - constrain(green, 0, 255));
  analogWrite(pinLedBlue,  255 - constrain(blue,  0, 255));
}

bool waiting = false;
unsigned long startWaitTime = 0;
unsigned long waitDuration = 0;

unsigned long startReactionTime = 0;
bool waitingForReaction = false;

// ---- Statistika po 5 bandymų ----
const int TRIALS_PER_SET = 5;
unsigned long sumRT = 0;
unsigned long minRT = 0xFFFFFFFFUL;
unsigned long maxRT = 0;
int trialCount = 0;
bool showingSummary = false;

void resetStats(){
  sumRT = 0;
  minRT = 0xFFFFFFFFUL;
  maxRT = 0;
  trialCount = 0;
}

void setup()
{
  pinMode(pinLedRed, OUTPUT);
  pinMode(pinLedBlue, OUTPUT);
  pinMode(pinLedGreen, OUTPUT);
  pinMode(pinButton, INPUT_PULLUP);
  
  lcd.begin(16, 2);
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Reaction Tester");
  
  setColor(255, 0, 0);
  
  randomSeed(analogRead(A0));
  lastButtonState = digitalRead(pinButton);
}

void loop() {
  int buttonState = digitalRead(pinButton);

  // Jei rodoma suvestinė – mygtuko paspaudimas pradeda naują seriją
  if (showingSummary) {
    if (lastButtonState == HIGH && buttonState == LOW) {
      showingSummary = false;
      resetStats();
      lcd.clear();
      lcd.setCursor(0,0);
      lcd.print("Press to start");
      setColor(255, 0, 0);
    }
    lastButtonState = buttonState;
    return; // kol rodom suvestinę, kitų būsenų nevykdom
  }

  // Startas: paspaudimas (HIGH -> LOW), jei kol kas nelaukiam
  if (!waiting && !waitingForReaction && lastButtonState == HIGH && buttonState == LOW) {
    setColor(255, 0, 0);
    waitDuration = random(1000, 5000);       // 1..5 s
    startWaitTime = millis();
    waiting = true;
    
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Get ready...");
  }

  // Baigėsi laukimas -> GO
  if (waiting && (millis() - startWaitTime >= waitDuration)) {
    setColor(0, 255, 0);
    waiting = false;
    waitingForReaction = true;
    startReactionTime = millis();
    
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("GO!");
  }
  
  // Užfiksuotas paspaudimas po GO -> rezultatą į statistiką
  if (waitingForReaction && lastButtonState == HIGH && buttonState == LOW) {
    unsigned long reactionTime = millis() - startReactionTime;
    waitingForReaction = false;

    // atnaujinti statistiką
    sumRT += reactionTime;
    if (reactionTime < minRT) minRT = reactionTime;
    if (reactionTime > maxRT) maxRT = reactionTime;
    trialCount++;

    // parodyti paskutinį rezultatą
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Time: ");
    lcd.print(reactionTime);
    lcd.print(" ms");
    lcd.setCursor(0, 1);
    lcd.print("Try ");
    lcd.print(trialCount);
    lcd.print("/");
    lcd.print(TRIALS_PER_SET);

    setColor(255, 0, 0);

    // jei tai 5-as bandymas -> parodyti suvestinę
    if (trialCount >= TRIALS_PER_SET) {
      unsigned long avg = sumRT / trialCount;
      lcd.clear();
      lcd.setCursor(0,0);
      lcd.print("Avg:");
      lcd.print(avg);
      lcd.print(" Min:");
      lcd.print(minRT);
      lcd.setCursor(0,1);
      lcd.print("Max:");
      lcd.print(maxRT);
      lcd.print("  (Press)");
      showingSummary = true; // laukiame mygtuko, kad pradėti naują seriją
    }
  }

  lastButtonState = buttonState;
}
