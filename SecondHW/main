#include <LiquidCrystal.h>
#include <EEPROM.h>

volatile unsigned long tickMs = 0;

unsigned long bestRT = 0xFFFFFFFFUL;
unsigned long lastRT = 0;

// Pinai
int pinLedRed = 11;
int pinLedBlue = 10;
int pinLedGreen = 9;
int pinButton = 8;

LiquidCrystal lcd(7, 6, 5, 4, 3, 2);

int lastButtonState = HIGH;

bool waiting = false;
unsigned long startWaitTime = 0;
unsigned long waitDuration = 0;

unsigned long startReactionTime = 0;
bool waitingForReaction = false;

struct Persist {
  uint32_t magic;
  uint8_t version;
  uint32_t bestRT;
};

const uint32_t P_MAGIC = 0xB35DB357UL;
const uint8_t P_VER = 1;

Persist P;

// Padariau taip, nes čia ir buvo problema su ledu, kadangi spalvos buvo visai ne tokios, kaip buvau nustated RGB
void setColor(int red, int green, int blue){
  analogWrite(pinLedRed,   255 - constrain(red,   0, 255));
  analogWrite(pinLedGreen, 255 - constrain(green, 0, 255));
  analogWrite(pinLedBlue,  255 - constrain(blue,  0, 255));
}

ISR(TIMER1_COMPA_vect){
  tickMs++;
}

void setupTimer1_1kHz(){
  noInterrupts();
  TCCR1A = 0;
  TCCR1B = 0;
  TCNT1 = 0;

  OCR1A = 15999;
  TCCR1B |= (1 << WGM12);
  TCCR1B |= (1 << CS10);
  TIMSK1 |= (1 << OCIE1A);
  interrupts();
}

unsigned long nowMs(){
  noInterrupts();
  unsigned long v = tickMs;
  interrupts();
  return v;
}

void loadPersist() {
  EEPROM.get(0, P);
  if(P.magic != P_MAGIC || P.version != P_VER) {
    P.magic = P_MAGIC;
    P.version = P_VER;
    P.bestRT = 0xFFFFFFFFUL;
    EEPROM.put(0, P);
  }
  bestRT = P.bestRT;
}

void saveBestIfBetter(uint32_t candidate) {
  if(candidate < P.bestRT){
    P.bestRT = candidate;
    EEPROM.put(0, P);
  }
}

void setup()
{
  pinMode(pinLedRed, OUTPUT);
  pinMode(pinLedBlue, OUTPUT);
  pinMode(pinLedGreen, OUTPUT);
  pinMode(pinButton, INPUT_PULLUP);
  
  lcd.begin(16, 2);
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Reaction Tester");

  setupTimer1_1kHz();

  setColor(255, 0, 0);
  
  randomSeed(analogRead(A0));
  lastButtonState = digitalRead(pinButton);

  loadPersist();

  unsigned long t0 = nowMs();
  while(nowMs() - t0 < 3000){}

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Press to start");
  lcd.setCursor(0, 1);
  lcd.print("Best: ");
  if(bestRT == 0xFFFFFFFFUL){
    lcd.print("--");
  } else {
    lcd.print(bestRT);
  }
}

void loop() {
  int buttonState = digitalRead(pinButton);

  // Startas: paspaudimas (HIGH -> LOW), jei kol kas nelaukiam
  if (!waiting && !waitingForReaction && lastButtonState == HIGH && buttonState == LOW) {
    setColor(255, 0, 0);
    waitDuration = random(1000, 5000);       // 1..5 s
    startWaitTime = nowMs();
    waiting = true;
    
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Get ready...");
    lcd.setCursor(0, 1);
    lcd.print("Best: ");
    if (bestRT == 0xFFFFFFFFUL){
      lcd.print("--");
    } else {
      lcd.print(bestRT);
    }
  }

  // Baigėsi laukimas -> GO
  if (waiting && (nowMs() - startWaitTime >= waitDuration)) {
    setColor(0, 255, 0);
    waiting = false;
    waitingForReaction = true;
    startReactionTime = nowMs();
    
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("GO!");
    lcd.setCursor(0, 1);
    lcd.print("Best: ");
    if (bestRT == 0xFFFFFFFFUL){
      lcd.print("--");
    } else {
      lcd.print(bestRT);
    }
  }
  
  // Užfiksuotas paspaudimas po GO -> rezultatą į statistiką
  if (waitingForReaction && lastButtonState == HIGH && buttonState == LOW) {
    unsigned long reactionTime = nowMs() - startReactionTime;
    waitingForReaction = false;
    lastRT = reactionTime;
    if(reactionTime < bestRT){
      bestRT = reactionTime;
      saveBestIfBetter(bestRT);
    }

    // parodyti paskutinį rezultatą
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Now: ");
    lcd.print(lastRT);
    lcd.print(" ms");
    lcd.setCursor(0, 1);
    lcd.print("Best: ");
    lcd.print(bestRT);

    setColor(255, 0, 0);
  }

  lastButtonState = buttonState;
}
