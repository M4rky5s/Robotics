#include <LiquidCrystal.h>
#include <EEPROM.h>

volatile unsigned long tickMs = 0;
volatile bool btnEdge = false;
volatile uint8_t acceptPress = 0;
volatile unsigned long lastIsrMs = 0;
volatile unsigned long ignoreUntilMs = 0;

unsigned long bestRT = 0xFFFFFFFFUL;
unsigned long lastRT = 0;

// Pinai
int pinLedRed = 11;
int pinLedBlue = 10;
int pinLedGreen = 9;
int pinButton = 2;

LiquidCrystal lcd(8, 7, 6, 5, 4, 3);

bool waiting = false;
unsigned long startWaitTime = 0;
unsigned long waitDuration = 0;

unsigned long startReactionTime = 0;
bool waitingForReaction = false;

bool inCooldown = false;
unsigned long cooldownUntil = 0;
bool introShown = false;
unsigned long introUntil = 0;

struct Persist {
  uint32_t magic;
  uint8_t version;
  uint32_t bestRT;
  uint32_t totalAttempts;
};

const uint32_t P_MAGIC = 0xB35DB357UL;
const uint8_t P_VER = 1;

Persist P;

// Padariau taip, nes čia ir buvo problema su ledu, kadangi spalvos buvo visai ne tokios, kaip buvau nustated RGB
void setColor(int red, int green, int blue){
  analogWrite(pinLedRed,   255 - constrain(red,   0, 255));
  analogWrite(pinLedGreen, 255 - constrain(green, 0, 255));
  analogWrite(pinLedBlue,  255 - constrain(blue,  0, 255));
}

ISR(TIMER1_COMPA_vect){
  tickMs++;
}

void setupTimer1_1kHz(){
  noInterrupts();
  TCCR1A = 0;
  TCCR1B = 0;
  TCNT1 = 0;

  OCR1A = 15999;
  TCCR1B |= (1 << WGM12);
  TCCR1B |= (1 << CS10);
  TIMSK1 |= (1 << OCIE1A);
  interrupts();
}

unsigned long nowMs(){
  noInterrupts();
  unsigned long v = tickMs;
  interrupts();
  return v;
}

void loadPersist() {
  EEPROM.get(0, P);
  if(P.magic != P_MAGIC || P.version != P_VER) {
    P.magic = P_MAGIC;
    P.version = P_VER;
    P.bestRT = 0xFFFFFFFFUL;
    P.totalAttempts = 0;
    EEPROM.put(0, P);
  }
  bestRT = P.bestRT;
}

void saveBestIfBetter(uint32_t candidate) {
  if(candidate < P.bestRT){
    P.bestRT = candidate;
    EEPROM.put(0, P);
  }
}

void saveAttemptsIfNeeded(){
  if(P.totalAttempts %10UL == 0UL){
    EEPROM.put(0, P);
  }
}

void onButtonFall(){
  unsigned long now = tickMs;

  if(now < ignoreUntilMs){
    return;
  }
  if(now - lastIsrMs < 50){
    return;
  }
  if(!acceptPress){
    return;
  }

  btnEdge = true;
  lastIsrMs = now;
}

void setup()
{
  pinMode(pinLedRed, OUTPUT);
  pinMode(pinLedBlue, OUTPUT);
  pinMode(pinLedGreen, OUTPUT);
  pinMode(pinButton, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(pinButton), onButtonFall, FALLING);
  
  lcd.begin(16, 2);
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Reaction Tester");

  setupTimer1_1kHz();

  introShown = true;
  introUntil = nowMs() + 3000;

  setColor(255, 0, 0);
  
  randomSeed(analogRead(A0));

  loadPersist();
  
}

void loop() {

  //Intro uzdarymas
  if(introShown){
    if(nowMs() >= introUntil){
      introShown = false;
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("Press to start");
      lcd.setCursor(0, 1);
      lcd.print("Best:");
      if(bestRT == 0xFFFFFFFFUL){
        lcd.print("--");
      } else {
        lcd.print(bestRT);
        lcd.print(" ms ");
        lcd.print("#");
        lcd.print(P.totalAttempts);
      }
      acceptPress = 1;
    }
    return;
  }

  // Startas: paspaudimas (HIGH -> LOW), jei kol kas nelaukiam
  if (!waiting && !waitingForReaction && btnEdge) {
    btnEdge = false;
    acceptPress = 0;

    setColor(255, 0, 0);
    waitDuration = random(1000, 5000);       // 1..5 s
    startWaitTime = nowMs();
    waiting = true;
    
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Get ready...");
    lcd.setCursor(0, 1);
    lcd.print("Best:");
    if (bestRT == 0xFFFFFFFFUL){
      lcd.print("--");
    } else {
      lcd.print(bestRT);
      lcd.print(" ms ");
      lcd.print("#");
      lcd.print(P.totalAttempts);
    }
  }

  // Baigėsi laukimas -> GO
  if (waiting && (nowMs() - startWaitTime >= waitDuration)) {
    setColor(0, 255, 0);
    waiting = false;
    waitingForReaction = true;
    startReactionTime = nowMs();
    
    ignoreUntilMs = startReactionTime + 10;
    acceptPress = 1;

    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("GO!");
    lcd.setCursor(0, 1);
    lcd.print("Best:");
    if (bestRT == 0xFFFFFFFFUL){
      lcd.print("--");
    } else {
      lcd.print(bestRT);
      lcd.print(" ms ");
      lcd.print("#");
      lcd.print(P.totalAttempts);
    }
  }
  
  // Užfiksuotas paspaudimas po GO -> rezultatą į statistiką
  if (waitingForReaction && btnEdge) {
    btnEdge = false;
    acceptPress = 0;
    unsigned long reactionTime = nowMs() - startReactionTime;
    waitingForReaction = false;
    lastRT = reactionTime;
    if(reactionTime < bestRT){
      bestRT = reactionTime;
      saveBestIfBetter(bestRT);
    }

    P.totalAttempts++;
    saveAttemptsIfNeeded();

    // parodyti paskutinį rezultatą
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Now: ");
    lcd.print(lastRT);
    lcd.print(" ms");
    lcd.setCursor(0, 1);
    lcd.print("Best:");
    lcd.print(bestRT);
    lcd.print(" ms ");
    lcd.print("#");
    lcd.print(P.totalAttempts);

    setColor(255, 0, 0);

    inCooldown = true;
    cooldownUntil = nowMs() + 1000;
  }

  if(inCooldown && nowMs() >= cooldownUntil){
      inCooldown = false;

      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("Press to start");
      lcd.setCursor(0, 1);
      lcd.print("Best:");
      if (bestRT == 0xFFFFFFFFUL) {
        lcd.print("--");
      } else {
        lcd.print(bestRT);
        lcd.print(" ms ");
        lcd.print("#");
        lcd.print(P.totalAttempts);
      }

      acceptPress = 1;
    }
}
